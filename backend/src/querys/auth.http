Content-Type: application/json

{
  "role": "profesional",
  "dni": "40111222",
  "nombre": "Ana",
  "apellido": "Paz",
  "correo": "ana.paz@example.com",
  "password": "miclave123",
  "confirm": "miclave123",
  "fecha_nacimiento": "1990-05-10",
  "genero": "F",
  "numero_matricula": "MP-99999"
}

