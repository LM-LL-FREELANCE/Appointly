DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=appointly
PORT=3000

JWT_SECRET=change_me_to_a_long_random_string
API_KEY=change_me_to_a_long_random_string
NODE_ENV=development

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_BUCKET_URL=https://pub-<HASH>.r2.dev

# Email (Resend). EMAIL_FROM must be a sender verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Appointly <no-reply@your-domain.com>
# Public URL of the frontend, used to build the links sent by email.
WEB_FROM=http://localhost:5173
